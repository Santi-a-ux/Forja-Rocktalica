:root {
  --color-fondo: #f4efe4;
  --color-superficie: #fffaf1;
  --color-tinta: #1c1916;
  --color-tinta-suave: #5b5348;
  --color-bosque: #2c4a3e;
  --color-bosque-oscuro: #1d332b;
  --color-terracota: #c45c26;
  --color-terracota-oscura: #9a4318;
  --color-oro: #c4a35a;
  --color-linea: #d9cbb3;
  --color-error: #9b2c2c;
  --color-exito: #276749;
  --sombra: 0 12px 30px rgba(28, 25, 22, 0.08);
  --radio: 16px;
  --fuente-display: "Fraunces", Georgia, serif;
  --fuente-texto: "Source Sans 3", "Segoe UI", sans-serif;
  --ancho: 1120px;
  --espacio-1: 0.35rem;
  --espacio-2: 0.7rem;
  --espacio-3: 1.1rem;
  --espacio-4: 1.8rem;
  --espacio-5: 3rem;
  --espacio-6: 5rem;
}

[data-tema="oscuro"] {
  --color-fondo: #14110f;
  --color-superficie: #1e1a17;
  --color-tinta: #f4efe4;
  --color-tinta-suave: #cbbda8;
  --color-bosque: #7ea894;
  --color-bosque-oscuro: #c4a35a;
  --color-linea: #3a332c;
  --color-error: #feb2b2;
  --color-exito: #9ae6b4;
  --sombra: 0 12px 30px rgba(0, 0, 0, 0.35);
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: var(--fuente-texto);
  font-size: 1.05rem;
  line-height: 1.6;
  color: var(--color-tinta);
  background: var(--color-fondo);
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

a {
  color: var(--color-bosque);
  text-decoration-thickness: 1px;
  text-underline-offset: 0.2em;
}

a:hover {
  color: var(--color-terracota);
}

:focus-visible {
  outline: 3px solid var(--color-terracota);
  outline-offset: 3px;
}

.saltar {
  position: absolute;
  left: -999px;
  top: 0;
  background: var(--color-superficie);
  color: var(--color-tinta);
  padding: var(--espacio-2) var(--espacio-3);
  z-index: 20;
}

.saltar:focus {
  left: var(--espacio-2);
  top: var(--espacio-2);
}

.envoltura {
  width: min(100% - 2rem, var(--ancho));
  margin-inline: auto;
}

.sitio-header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: color-mix(in srgb, var(--color-fondo) 92%, transparent);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--color-linea);
}

.barra {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--espacio-3);
  min-height: 4.4rem;
}

.marca {
